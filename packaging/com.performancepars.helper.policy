<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>PerformancePars</vendor>
  <vendor_url>https://github.com/techasl7585/performancepars</vendor_url>

  <action id="com.performancepars.read-smart">
    <description>Depolama aygıtının sağlık bilgisini oku</description>
    <message>PerformancePars depolama sağlık bilgisini okumak istiyor</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/performancepars/performancepars-helper</annotate>
  </action>
</policyconfig>
